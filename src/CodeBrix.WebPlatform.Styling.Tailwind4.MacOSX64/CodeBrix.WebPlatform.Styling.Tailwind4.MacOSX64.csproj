<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64.MitLicenseForever</PackageId>
    <Product>CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64</Product>
    <Title>CodeBrix.WebPlatform.Styling.Tailwind4.MacOSX64</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>The prebuilt standalone Tailwind CSS 4.3.5 program (tailwindcss) for macOS x64 (Intel) build machines, packaged for building CodeBrix.WebPlatform applications. Referencing the package copies the program, with its licence and third-party notices files, into the referencing project's output folder as tailwind/osx-x64/ - nothing has to be installed, and no Node.js is involved. Choose the package of the machine the frontend is BUILT on. The source of the program, including the LGPL-licensed source it contains, comes with the CodeBrix.WebPlatform.Styling.Tailwind4.Sources package, which this package depends on.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.Styling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.Styling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>tailwind;tailwindcss;css;styling;webplatform;build;tools;macos;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    The Tailwind program this package carries: the file in the Tailwind release, where it is
    downloaded from and its sha256. CodeBrix.WebPlatform.Styling.Tailwind4.Platform.targets
    downloads, checks, renames and packs it (see that file). TailwindTool.cs holds the same values
    as constants; the tests check that the two agree.
  -->
  <PropertyGroup>
    <TailwindRuntimeIdentifier>osx-x64</TailwindRuntimeIdentifier>
    <TailwindReleaseFileName>tailwindcss-macos-x64</TailwindReleaseFileName>
    <TailwindReleaseUrl>https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.5/tailwindcss-macos-x64</TailwindReleaseUrl>
    <TailwindSha256>a63702686a3ed048b3135d84a73be49ea9d47f880c9b20e54b3ef60934ad8cdf</TailwindSha256>
    <TailwindExecutableFileName>tailwindcss</TailwindExecutableFileName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The source package every platform package depends on (one exact version; see the target below). -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.WebPlatform.Styling.Tailwind4.Sources\CodeBrix.WebPlatform.Styling.Tailwind4.Sources.csproj" />
  </ItemGroup>

  <Import Project="..\CodeBrix.WebPlatform.Styling.Tailwind4.Platform.targets" />

</Project>
