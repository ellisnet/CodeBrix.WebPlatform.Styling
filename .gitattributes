# Line endings: LF, everywhere, on every platform.
#
# The committed files are LF. These rules only stop a checkout from changing them
# (core.autocrlf=true on Windows would expand LF to CRLF).
* text=auto eol=lf

# Never touched. A binary file with newline translation applied to it is silently
# corrupt, so these are declared rather than left to git's heuristic. The source zips
# in info/ have sha256 hashes recorded in SOURCES-README.txt and checked by the build.
*.png    binary
*.zip    binary
*.gz     binary
*.nupkg  binary
*.exe    binary
*.dll    binary
*.pdb    binary
