<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebPlatform.Styling.Tailwind4.Sources</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.Styling.Tailwind4.Sources</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!--
    No licence suffix on this package id: the archives it carries are under several licences
    (MIT, BSD, LGPL, MPL and others), and no single one describes the package. The licence
    metadata is therefore a licence FILE, SOURCES-LICENSES.txt, which lists each archive's
    licences.
  -->
  <PropertyGroup>
    <PackageId>CodeBrix.WebPlatform.Styling.Tailwind4.Sources</PackageId>
    <Product>CodeBrix.WebPlatform.Styling.Tailwind4.Sources</Product>
    <Title>CodeBrix.WebPlatform.Styling.Tailwind4.Sources</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>The source code of the prebuilt standalone Tailwind CSS 4.3.5 programs that the CodeBrix.WebPlatform.Styling.Tailwind4 platform packages carry, as zip archives under sources/v4.3.5/: Tailwind CSS itself, the Bun runtime the programs are compiled with, and the LGPL-licensed JavaScriptCore (WebKit) and TinyCC source that the runtime contains. The platform packages depend on this package, so the source always comes with the programs. Nothing is copied into a consuming build.</Description>
    <PackageLicenseFile>SOURCES-LICENSES.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.Styling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.Styling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>tailwind;tailwindcss;source;lgpl;webplatform;styling;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The committed source archives (info/v4.3.5/, described in SOURCES-README.txt there) and their
    sha256 hashes. Every build checks every archive against its hash before anything is packed;
    TailwindSources.cs holds the same hashes and the tests check that the two agree.
  -->
  <PropertyGroup>
    <TailwindVersion>4.3.5</TailwindVersion>
    <TailwindSourcesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\info\v$(TailwindVersion)'))</TailwindSourcesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <TailwindSourceArchive Include="$(TailwindSourcesDirectory)\tailwindcss-4.3.5.zip" Sha256="bb27af0df1b87280e62bff9bd71c1cdbd4a2a466d037f85c86e7914e65a3b687" />
    <TailwindSourceArchive Include="$(TailwindSourcesDirectory)\oven-sh-bun-v1.4.3.zip" Sha256="530261669eaa7061cd4c1c69ba2beccd44f271ea7ca99cbc19c7f50589d09935" />
    <TailwindSourceArchive Include="$(TailwindSourcesDirectory)\oven-sh-WebKit-0c06faad-JSCOnly.zip" Sha256="495ecba149b6a436f1eb92f5cb06713c1dc5eafd941526fde7fa0de422158e47" />
    <TailwindSourceArchive Include="$(TailwindSourcesDirectory)\oven-sh-tinycc-05f0fafa.zip" Sha256="f141c6ad0b823bed68d21fa6b104e4a5df9de8eaecd1e2c3b5abbee24eff40be" />
  </ItemGroup>

  <ItemGroup>
    <None Include="@(TailwindSourceArchive);$(TailwindSourcesDirectory)\SOURCES-README.txt"
          Pack="true" PackagePath="sources\v$(TailwindVersion)\" Visible="false" />
    <None Include="$(TailwindSourcesDirectory)\SOURCES-LICENSES.txt" Pack="true" PackagePath="" Visible="false" />
    <AssemblyMetadata Include="TailwindVersion" Value="$(TailwindVersion)" />
    <AssemblyMetadata Include="@(TailwindSourceArchive->'SourceArchive:%(Filename)%(Extension)')" Value="%(Sha256)" />
  </ItemGroup>

  <Target Name="CheckTailwindSourceArchives" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('%(TailwindSourceArchive.Identity)')" Text="The source archive %(TailwindSourceArchive.Identity) is missing. Nothing was packed." />
    <GetFileHash Files="@(TailwindSourceArchive)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_TailwindSourceArchiveHash" />
    </GetFileHash>
    <Error Condition="'%(_TailwindSourceArchiveHash.FileHash)' != '' And '$([System.String]::Copy(%(_TailwindSourceArchiveHash.FileHash)).ToLowerInvariant())' != '$([System.String]::Copy(%(_TailwindSourceArchiveHash.Sha256)).ToLowerInvariant())'"
           Text="%(_TailwindSourceArchiveHash.Identity) has sha256 %(_TailwindSourceArchiveHash.FileHash); %(_TailwindSourceArchiveHash.Sha256) was expected (SOURCES-README.txt). Nothing was packed." />
  </Target>

</Project>
